\ProvidesPackage{formatacao}

\def\@formataautorcapa{%
  \parbox[b]{\titlepagewinwidth}
  {%
    \centering\vbox to \titlepagewinheight
    {%
      \vspace*{\fill}
      {\textbf{\imprimirautor}}
      \vspace*{\fill}
    }
  }
}

\def\@formatatitulocapa{%
  \parbox[b]{\titlepagewinwidth}
  {%
    \centering\vbox to \titlepagewinheight
    {%
      \vspace*{\fill}
      {\textbf{\imprimirtitulo}\par}
      \vspace*{\fill}
    }
  }
}

